{
  "name": "ondrej-michal-ockaj-business-analyst-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize-svgs": "svgo -r -f public/BPMN_models",
    "gate": "node scripts/verify-gate.mjs",
    "verify": "npm run gate && npx vitest run --reporter=minimal && npm run typecheck && npm run lint && npm run doctor && npm run knip && npm run build",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "knip": "knip",
    "doctor": "react-doctor --verbose",
    "test:e2e": "node scripts/e2e/runner.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@number-flow/react": "^0.6.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "ogl": "^1.0.11",
    "quicklink": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "slot-text": "^0.3.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint-react/eslint-plugin": "^5.27.2",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/quicklink": "^2.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "boneyard-js": "^1.10.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-google-translate": "^1.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.18",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.5",
    "web-vitals": "^6.2.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@babel/plugin-proposal-private-methods": "npm:@babel/plugin-transform-private-methods@^7.22.0",
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.2"
    },
    "eslint": "$eslint",
    "@babel/core": "$@babel/core"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  }
}
